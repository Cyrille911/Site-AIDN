# Django settings
DEBUG=0
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,app.aidn.ci,dpse.aidn.ci,dpse.mfb.gouv.ci,.aidn.ci,.mfb.gouv.ci
CSRF_TRUSTED_ORIGINS=https://*.aidn.ci,https://*.mfb.gouv.ci,http://localhost:8000

# SaaS central domain
SAAS_CENTRAL_DOMAIN=app.aidn.ci

# Database settings (PostgreSQL par défaut, remplacer par MySQL pour DPSE)
POSTGRES_DB=aidn_db
POSTGRES_USER=aidn_user
POSTGRES_PASSWORD=your-secure-password-here
DATABASE_URL=postgres://aidn_user:your-secure-password-here@db:5432/aidn_db

# Django database settings
DB_HOST=db
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email settings
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
