# Modèle de configuration : cp env.template .env, puis renseigner les valeurs.
# Le fichier .env n'est jamais versionné.

# --- Django ---
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changer-moi
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,app.aidn.ci,dpse.aidn.ci,.aidn.ci
CSRF_TRUSTED_ORIGINS=https://*.aidn.ci,http://localhost:8005
SAAS_CENTRAL_DOMAIN=app.aidn.ci

# --- Base de données (PostgreSQL, service "db" du docker-compose) ---
# Sans DB_HOST, Django retombe sur SQLite (dev sans Docker).
POSTGRES_DB=aidn_db
POSTGRES_USER=aidn_user
POSTGRES_PASSWORD=changer-moi
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Email (compte Gmail d'envoi + mot de passe d'application) ---
EMAIL_HOST_USER=aidn.tech@gmail.com
EMAIL_HOST_PASSWORD=changer-moi
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=contact@aidn.ci
